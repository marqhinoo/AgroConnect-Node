<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center"
    android:background="@color/bg_dark_deep">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AGRO MONITOR"
        android:textColor="@color/green_neon"
        android:textSize="32sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Telemetría y Control de Lotes"
        android:textColor="@color/text_muted_gray"
        android:textSize="14sp"
        android:layout_marginBottom="40dp"/>

    <EditText
        android:id="@+id/etEmail"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:hint="Email"
        android:textColorHint="@color/text_muted_gray"
        android:textColor="@color/text_pure_white"
        android:background="@drawable/bg_tarjeta_premium"
        android:paddingHorizontal="16dp"
        android:inputType="textEmailAddress"
        android:layout_marginBottom="16dp"
        android:textSize="16sp"/>

    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:hint="Contraseña"
        android:textColorHint="@color/text_muted_gray"
        android:textColor="@color/text_pure_white"
        android:background="@drawable/bg_tarjeta_premium"
        android:paddingHorizontal="16dp"
        android:inputType="textPassword"
        android:layout_marginBottom="32dp"
        android:textSize="16sp"/>

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="ENTRAR"
        android:backgroundTint="@color/green_neon"
        android:textColor="@color/bg_dark_deep"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="14dp"/>

</LinearLayout>